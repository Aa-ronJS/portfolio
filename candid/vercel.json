{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/r/:token",
      "destination": "/r.html"
    }
  ],
  "functions": {
    "api/business.js": {
      "maxDuration": 60,
      "memory": 512,
      "includeFiles": "db/**"
    },
    "api/reviewer.js": {
      "maxDuration": 60,
      "memory": 512,
      "includeFiles": "db/**"
    },
    "api/auth.js": {
      "maxDuration": 10,
      "memory": 256,
      "includeFiles": "db/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
