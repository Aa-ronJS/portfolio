# Copy to .env and fill in. .env is gitignored.
ELEVENLABS_API_KEY=
# Your cloned voice: ElevenLabs > Voices > My Voices > copy voice ID
VOICE_ID=
# Printed by `node setup-agent.mjs`
AGENT_ID=
# Optional. Left blank, call.mjs uses the first number imported into ElevenLabs.
AGENT_PHONE_NUMBER_ID=
# Who the agent is calling for
OWNER_NAME=Aaron Steele
# Optional: number people can ring back on
CALLBACK_NUMBER=
