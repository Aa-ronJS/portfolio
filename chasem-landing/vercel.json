{
  "cleanUrls": true,
  "functions": {
    "api/demo.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/msg.js": {
      "maxDuration": 30,
      "memory": 256
    },
    "api/stripe-webhook.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/setup-link.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/sms-in.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/renew.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/portal.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/signup.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/topup.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/seat.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/sync.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/y.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/photo.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/admin.js": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/app/move(.html)?",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://go.chasem.app https://chasem.app https://www.chasem.app"
        }
      ]
    },
    {
      "source": "/move(.html)?",
      "has": [
        {
          "type": "host",
          "value": "go.chasem.app"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://go.chasem.app https://chasem.app https://www.chasem.app"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/measure",
      "destination": "/measure/measure"
    },
    {
      "source": "/measure/",
      "destination": "/measure/measure"
    },
    {
      "source": "/y/:t",
      "destination": "/api/y?t=:t"
    }
  ],
  "redirects": [
    {
      "source": "/measure",
      "destination": "/measure/",
      "permanent": true
    }
  ]
}
