# copy to .env and `set -a; . ./.env; set +a` before npm start (or use your host's secrets)
ADMIN_PASSWORD=change-me
ADMIN_USER=admin
BRAND=Your Brand Name
LEGAL_NAME=Aaron Steele
ABN=00 000 000 000
CONTACT_PHONE=0400 000 000
CONTACT_EMAIL=hello@example.com
BASE_URL=http://localhost:3000
CHECKOUT_URL=
NOTIFY_WEBHOOK=
DB_PATH=./data/kits.db
REFILL_MONTHS=6
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=
# --- autopilot ---
FOUNDER_EMAIL=                      # the one weekly email goes here (defaults to CONTACT_EMAIL)
MAIL_API_URL=                       # e.g. https://api.postmarkapp.com/email ; empty = emails stay queued in the outbox
MAIL_API_KEY=
MAIL_FROM=
INBOUND_SECRET=                     # inbound email webhook: POST /webhooks/inbox?key=...
FULFIL_WEBHOOK=                     # 3PL order endpoint or n8n flow; empty = you pack from the due list
FULFIL_WEBHOOK_KEY=
FULFIL_WEBHOOK_SECRET=              # what the 3PL sends back on /webhooks/fulfilment
SUPPLIER_EMAIL=                     # purchase orders go here when under AUTO_PO_CAP
SUPPLIER_NAME=Aero Healthcare (reseller account)
AUTO_PO_CAP=1500                    # A$; larger purchase orders wait for a tap
AUTO_PAYOUT_CAP=0                   # A$; 0 = partner payouts always wait for a tap
CANCEL_AFTER_DAYS=21                # past due this long -> plan closes
ADS_BUDGET_PM=600                   # current Google Ads monthly budget, for the weekly rule
ADS_MAX_PM=7000
STRIPE_PORTAL_URL=                  # optional no-code customer portal link, used when the API portal call is unavailable
INBOX_CLASSIFIER=                   # keywords | claude ; default: claude when a key is present
