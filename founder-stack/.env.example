# ============================================================
# Founder Stack configuration
# install.sh copies this to .env and fills in every __GEN_*__
# placeholder with a freshly generated secret. Edit .env, not
# this file.
# ============================================================

# --- Global -------------------------------------------------
# Apex domain. Apps live on subdomains: cal.example.com, crm.example.com, ...
BASE_DOMAIN=example.com
# Absolute path of this directory on the server (install.sh fills it in;
# the console mounts the stack at this path)
STACK_ROOT=/opt/founder-stack

# --- Brand (applied everywhere with: stackctl brand apply, or the console) --
BRAND_NAME=Founder Stack
BRAND_COLOR=#4f46e5
# Blank = brand/logo.svg served by the console. Or any public https URL.
BRAND_LOGO_URL=
# Email used for Let's Encrypt certificate registration + expiry notices.
ACME_EMAIL=you@example.com
TZ=UTC

# Default admin identity, pre-seeded where the app supports it.
ADMIN_EMAIL=you@example.com
ADMIN_USER=admin
ADMIN_PASSWORD=__GEN_PASSWORD__

# --- Access knobs (editable per app in the console) ---------
# Who may create their own account. People you add from the console never
# need these; they exist so you can lock the doors once the team is in.
VIKUNJA_REGISTRATION_OPEN=true
ACTIVEPIECES_SIGNUP_OPEN=true
CHATWOOT_ACCOUNT_SIGNUP=false
MATTERMOST_OPEN_SERVER=false
DOCUMENSO_DISABLE_SIGNUP=false
CALCOM_DISABLE_SIGNUP=false
TWENTY_DISABLE_SIGNUP=false
ROCKETCHAT_REGISTRATION=Public

# --- Outbound email (optional but recommended) --------------
# Any SMTP relay: Amazon SES, Postmark, Mailgun, your own.
# Leave blank to run without outbound email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# --- Single sign-on (auth.BASE_DOMAIN) ----------------------
# Master switch — don't edit by hand; flip with: ./stackctl sso on|off
SSO_ENABLED=false
AUTHENTIK_DB_PASSWORD=__GEN_PASSWORD__
AUTHENTIK_SECRET_KEY=__GEN_HEX_64__
# API token for `stackctl user` provisioning (registered on Authentik's first boot)
AUTHENTIK_BOOTSTRAP_TOKEN=__GEN_HEX_64__
# OIDC client secrets (auto-registered in Authentik by its blueprint)
VIKUNJA_OIDC_CLIENT_SECRET=__GEN_HEX_32__
MATTERMOST_OIDC_CLIENT_SECRET=__GEN_HEX_32__
DOCUMENSO_OIDC_CLIENT_SECRET=__GEN_HEX_32__
DOCUMENSO_OIDC_WELL_KNOWN=
VAULTWARDEN_OIDC_CLIENT_SECRET=__GEN_HEX_32__
LISTMONK_OIDC_CLIENT_SECRET=__GEN_HEX_32__
NEXTCLOUD_OIDC_CLIENT_SECRET=__GEN_HEX_32__

# --- Cal.com (cal.BASE_DOMAIN) ------------------------------
CALCOM_DB_PASSWORD=__GEN_PASSWORD__
CALCOM_NEXTAUTH_SECRET=__GEN_B64_32__
CALCOM_ENCRYPTION_KEY=__GEN_B64_32__

# --- Invoice Ninja (invoices.BASE_DOMAIN) -------------------
INVOICENINJA_DB_PASSWORD=__GEN_PASSWORD__
INVOICENINJA_APP_KEY=__GEN_LARAVEL_KEY__

# --- Twenty CRM (crm.BASE_DOMAIN) ---------------------------
TWENTY_DB_PASSWORD=__GEN_PASSWORD__
TWENTY_APP_SECRET=__GEN_B64_32__

# --- Activepieces (automate.BASE_DOMAIN) --------------------
ACTIVEPIECES_DB_PASSWORD=__GEN_PASSWORD__
ACTIVEPIECES_API_KEY=__GEN_HEX_32__
# must be exactly 32 hex chars (16 bytes)
ACTIVEPIECES_ENCRYPTION_KEY=__GEN_HEX_32__
ACTIVEPIECES_JWT_SECRET=__GEN_HEX_32__

# --- Listmonk (newsletter.BASE_DOMAIN) ----------------------
LISTMONK_DB_PASSWORD=__GEN_PASSWORD__

# --- Formbricks (forms.BASE_DOMAIN) -------------------------
FORMBRICKS_DB_PASSWORD=__GEN_PASSWORD__
FORMBRICKS_NEXTAUTH_SECRET=__GEN_HEX_32__
FORMBRICKS_ENCRYPTION_KEY=__GEN_HEX_32__
FORMBRICKS_CRON_SECRET=__GEN_HEX_32__

# --- Vikunja (tasks.BASE_DOMAIN) ----------------------------
VIKUNJA_JWT_SECRET=__GEN_HEX_32__

# --- Docmost (docs.BASE_DOMAIN) -----------------------------
DOCMOST_DB_PASSWORD=__GEN_PASSWORD__
DOCMOST_APP_SECRET=__GEN_HEX_32__

# --- Mattermost (chat.BASE_DOMAIN) --------------------------
MATTERMOST_DB_PASSWORD=__GEN_PASSWORD__

# --- Chatwoot (support.BASE_DOMAIN) -------------------------
CHATWOOT_DB_PASSWORD=__GEN_PASSWORD__
CHATWOOT_SECRET_KEY_BASE=__GEN_HEX_64__

# --- Documenso (sign.BASE_DOMAIN) ---------------------------
DOCUMENSO_DB_PASSWORD=__GEN_PASSWORD__
DOCUMENSO_NEXTAUTH_SECRET=__GEN_B64_32__
DOCUMENSO_ENCRYPTION_KEY=__GEN_HEX_32__
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=__GEN_HEX_32__

# --- Umami (analytics.BASE_DOMAIN) --------------------------
UMAMI_DB_PASSWORD=__GEN_PASSWORD__
UMAMI_APP_SECRET=__GEN_HEX_32__

# --- Nextcloud (files.BASE_DOMAIN) --------------------------
NEXTCLOUD_DB_PASSWORD=__GEN_PASSWORD__
NEXTCLOUD_DB_ROOT_PASSWORD=__GEN_PASSWORD__

# --- Vaultwarden (vault.BASE_DOMAIN) ------------------------
VAULTWARDEN_ADMIN_TOKEN=__GEN_HEX_32__
# Flip to false after you've created your account(s).
VAULTWARDEN_SIGNUPS_ALLOWED=true

# --- Ghost (blog.BASE_DOMAIN) -------------------------------
GHOST_DB_PASSWORD=__GEN_PASSWORD__
GHOST_DB_ROOT_PASSWORD=__GEN_PASSWORD__

# --- ARM alternatives (for the $0 Oracle Always Free path) --
# calcom, twenty and mattermost ship amd64-only images; these three
# replace them on arm64 servers and share their subdomains. docs/ZERO-COST.md
ESPOCRM_DB_PASSWORD=__GEN_PASSWORD__
ESPOCRM_DB_ROOT_PASSWORD=__GEN_PASSWORD__
EASYAPPOINTMENTS_DB_PASSWORD=__GEN_PASSWORD__
EASYAPPOINTMENTS_DB_ROOT_PASSWORD=__GEN_PASSWORD__

# --- Cloudflare Tunnel (optional: home server / no public IP) --------
# Token from Cloudflare Zero Trust → Networks → Tunnels → your tunnel.
# Public hostname: *.BASE_DOMAIN → https://traefik:443 (TLS: No TLS Verify on)
CF_TUNNEL_TOKEN=

# --- Website (BASE_DOMAIN, www., site.) --------------------
WORDPRESS_DB_PASSWORD=__GEN_PASSWORD__
WORDPRESS_DB_ROOT_PASSWORD=__GEN_PASSWORD__
# true = install WooCommerce (online shop) on the website
WORDPRESS_WOOCOMMERCE=false

# --- Short links (links., links-admin.) ---------------------
SHLINK_DB_PASSWORD=__GEN_PASSWORD__
SHLINK_API_KEY=__GEN_HEX_32__
# htpasswd line (admin login) protecting admin-only pages: short-links UI, video maker. install.sh derives it.
ADMIN_HTPASSWD=

# --- Domain & DNS ------------------------------------------
# Cloudflare API token (Zone:DNS:Edit on your zone) for `stackctl dns cloudflare`
CF_API_TOKEN=
# DuckDNS token + subdomain for `stackctl dns duckdns up` (home servers)
DUCKDNS_TOKEN=
DUCKDNS_SUBDOMAIN=

# --- Automations (automate. = n8n; flows. = Activepieces alternative) -----
N8N_DB_PASSWORD=__GEN_PASSWORD__
N8N_ENCRYPTION_KEY=__GEN_HEX_32__

# --- Video: hosting (video.), live (live.), maker (studio.) ---------------
PEERTUBE_DB_PASSWORD=__GEN_PASSWORD__
PEERTUBE_SECRET=__GEN_HEX_64__
# OBS stream key for the live page
OWNCAST_STREAM_KEY=__GEN_HEX_16__
# Video maker AI presenter: render every Nth frame on CPU (2 = default, half the time; 1 = smoothest)
AVATAR_FRAME_STEP=2

# --- Meetings (meet.) — also open UDP 10000 on the server -----------------
JITSI_JICOFO_PASSWORD=__GEN_HEX_32__
JITSI_JVB_PASSWORD=__GEN_HEX_32__

# --- Social scheduler (social.) -------------------------------------------
POSTIZ_DB_PASSWORD=__GEN_PASSWORD__
POSTIZ_JWT_SECRET=__GEN_HEX_64__
POSTIZ_DISABLE_REGISTRATION=false

# --- AI assistant (ai.) — optional, RAM-hungry -----------------------------
OPENWEBUI_SECRET_KEY=__GEN_HEX_32__
OPENWEBUI_SIGNUP=true
OPENWEBUI_MODEL=llama3.2:3b
