.vercel/
*.log
node_modules/

# never commit local secrets, whichever subproject writes them
.env
.env.*
!.env.example

# essay-channel: generated media stays out of git; the record (json/md) stays in
essay-channel/cache/
essay-channel/episodes/*/voice/
essay-channel/episodes/*/work/
essay-channel/episodes/*/*.mp4
essay-channel/episodes/*/*.ass
essay-channel/episodes/*/thumbnail.jpg
essay-channel/episodes/*/thumbnails/
essay-channel/music/*
!essay-channel/music/README.md

# python bytecode, anywhere
__pycache__/
*.pyc
