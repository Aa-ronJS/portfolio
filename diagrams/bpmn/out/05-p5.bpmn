<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="p5_defs" targetNamespace="http://example.com/od-radio">
<bpmn:collaboration id="p5_collab">
<bpmn:participant id="p5_pool" name="Fibre / IP transport and riser" processRef="p5_process"/>
</bpmn:collaboration>
<bpmn:process id="p5_process" name="Fibre, IP network and riser to surface" isExecutable="false">
<bpmn:laneSet id="p5_ls">
<bpmn:lane id="p5_N" name="Level equipment (fibre node / AP)">
<bpmn:flowNodeRef>p5_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5_src</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p5_K" name="Underground comms cabinet">
<bpmn:flowNodeRef>p5_pp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5_sw</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5_gl</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5_el</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p5_B" name="Fibre backbone ring">
<bpmn:flowNodeRef>p5_ring</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5_gr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5_fo</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5_grm</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p5_S" name="Shaft / decline riser">
<bpmn:flowNodeRef>p5_gp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5_sh</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5_de</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5_gsm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5_gd</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5_spof</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p5_R" name="Surface comms room">
<bpmn:flowNodeRef>p5_core</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="p5_s" name="Optical or IP traffic leaves the level">
<bpmn:outgoing>p5_f0</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:serviceTask id="p5_src" name="Fibre node optical output / Wi-Fi AP / LTE radio head (PoE)">
<bpmn:incoming>p5_f0</bpmn:incoming>
<bpmn:outgoing>p5_f1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p5_pp" name="Fibre patch panel, splice tray, SFP optics, patch leads">
<bpmn:incoming>p5_f1</bpmn:incoming>
<bpmn:outgoing>p5_f2</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p5_sw" name="Managed industrial Ethernet switch (L2/L3, ring protocol, PoE)">
<bpmn:incoming>p5_f2</bpmn:incoming>
<bpmn:outgoing>p5_f3</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="p5_gl" name="Port and link up?">
<bpmn:incoming>p5_f3</bpmn:incoming>
<bpmn:outgoing>p5_f4</bpmn:outgoing>
<bpmn:outgoing>p5_f5</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="p5_el" name="Link alarm → tech: swap SFP / lead / switch; OTDR the fibre">
<bpmn:incoming>p5_f5</bpmn:incoming>
<bpmn:messageEventDefinition id="p5_el_med"/>
</bpmn:endEvent>
<bpmn:serviceTask id="p5_ring" name="Armoured single-mode loose-tube fibre ring between levels">
<bpmn:incoming>p5_f4</bpmn:incoming>
<bpmn:outgoing>p5_f6</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="p5_gr" name="Both ring paths intact?">
<bpmn:incoming>p5_f6</bpmn:incoming>
<bpmn:outgoing>p5_f7</bpmn:outgoing>
<bpmn:outgoing>p5_f8</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="p5_fo" name="Ring fails over the other way (&lt;50 ms); alarm to NMS">
<bpmn:incoming>p5_f8</bpmn:incoming>
<bpmn:outgoing>p5_f9</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="p5_grm" name="">
<bpmn:incoming>p5_f7</bpmn:incoming>
<bpmn:incoming>p5_f9</bpmn:incoming>
<bpmn:outgoing>p5_f10</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="p5_gp" name="Which riser path?">
<bpmn:incoming>p5_f10</bpmn:incoming>
<bpmn:outgoing>p5_f11</bpmn:outgoing>
<bpmn:outgoing>p5_f12</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="p5_sh" name="Shaft: vertical-rated coax + fibre, shaft clamps, strain relief at collar, cage feeder">
<bpmn:incoming>p5_f11</bpmn:incoming>
<bpmn:outgoing>p5_f13</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p5_de" name="Main decline: leaky feeder + fibre to the portal (vehicle coverage too)">
<bpmn:incoming>p5_f12</bpmn:incoming>
<bpmn:outgoing>p5_f14</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="p5_gsm" name="">
<bpmn:incoming>p5_f13</bpmn:incoming>
<bpmn:incoming>p5_f14</bpmn:incoming>
<bpmn:outgoing>p5_f15</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="p5_gd" name="Second, diverse route available?">
<bpmn:incoming>p5_f15</bpmn:incoming>
<bpmn:outgoing>p5_f16</bpmn:outgoing>
<bpmn:outgoing>p5_f17</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:manualTask id="p5_spof" name="Log single point of failure; plan a diverse route">
<bpmn:incoming>p5_f17</bpmn:incoming>
<bpmn:outgoing>p5_f18</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:serviceTask id="p5_core" name="Surface comms room: patch panel, core switch, headend interface">
<bpmn:incoming>p5_f16</bpmn:incoming>
<bpmn:incoming>p5_f18</bpmn:incoming>
<bpmn:outgoing>p5_f19</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="p5_e" name="Delivered to headend (p.6)">
<bpmn:incoming>p5_f19</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="p5_f0" name="" sourceRef="p5_s" targetRef="p5_src"/>
<bpmn:sequenceFlow id="p5_f1" name="" sourceRef="p5_src" targetRef="p5_pp"/>
<bpmn:sequenceFlow id="p5_f2" name="" sourceRef="p5_pp" targetRef="p5_sw"/>
<bpmn:sequenceFlow id="p5_f3" name="" sourceRef="p5_sw" targetRef="p5_gl"/>
<bpmn:sequenceFlow id="p5_f4" name="Yes" sourceRef="p5_gl" targetRef="p5_ring"/>
<bpmn:sequenceFlow id="p5_f5" name="No" sourceRef="p5_gl" targetRef="p5_el"/>
<bpmn:sequenceFlow id="p5_f6" name="" sourceRef="p5_ring" targetRef="p5_gr"/>
<bpmn:sequenceFlow id="p5_f7" name="Yes" sourceRef="p5_gr" targetRef="p5_grm"/>
<bpmn:sequenceFlow id="p5_f8" name="No" sourceRef="p5_gr" targetRef="p5_fo"/>
<bpmn:sequenceFlow id="p5_f9" name="" sourceRef="p5_fo" targetRef="p5_grm"/>
<bpmn:sequenceFlow id="p5_f10" name="" sourceRef="p5_grm" targetRef="p5_gp"/>
<bpmn:sequenceFlow id="p5_f11" name="Shaft" sourceRef="p5_gp" targetRef="p5_sh"/>
<bpmn:sequenceFlow id="p5_f12" name="Decline" sourceRef="p5_gp" targetRef="p5_de"/>
<bpmn:sequenceFlow id="p5_f13" name="" sourceRef="p5_sh" targetRef="p5_gsm"/>
<bpmn:sequenceFlow id="p5_f14" name="" sourceRef="p5_de" targetRef="p5_gsm"/>
<bpmn:sequenceFlow id="p5_f15" name="" sourceRef="p5_gsm" targetRef="p5_gd"/>
<bpmn:sequenceFlow id="p5_f16" name="Yes" sourceRef="p5_gd" targetRef="p5_core"/>
<bpmn:sequenceFlow id="p5_f17" name="No" sourceRef="p5_gd" targetRef="p5_spof"/>
<bpmn:sequenceFlow id="p5_f18" name="" sourceRef="p5_spof" targetRef="p5_core"/>
<bpmn:sequenceFlow id="p5_f19" name="" sourceRef="p5_core" targetRef="p5_e"/>
<bpmn:textAnnotation id="p5_a1"><bpmn:text>IP-rated cabinet: dust seal, cooling, earth bar, cable glands, cabinet UPS + PDU, media converters, RoIP gateway</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="p5_a1_as" sourceRef="p5_sw" targetRef="p5_a1"/>
</bpmn:process>
