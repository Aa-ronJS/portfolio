<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="p3_defs" targetNamespace="http://example.com/od-radio">
<bpmn:collaboration id="p3_collab">
<bpmn:participant id="p3_pool" name="Leaky-feeder uplink transit" processRef="p3_process"/>
</bpmn:collaboration>
<bpmn:process id="p3_process" name="Uplink along the leaky feeder" isExecutable="false">
<bpmn:laneSet id="p3_ls">
<bpmn:lane id="p3_A" name="RF path in the drive">
<bpmn:flowNodeRef>p3_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3_air</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p3_C" name="Leaky-feeder cable &amp; passives">
<bpmn:flowNodeRef>p3_in</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3_gj</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3_sp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3_gjm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3_con</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3_ga</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3_att</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3_gx</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3_gh2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3_eh</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p3_M" name="Line amplifiers">
<bpmn:flowNodeRef>p3_dip</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3_gain</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3_gh</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3_ealm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3_gc</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p3_O" name="Fibre-optic node">
<bpmn:flowNodeRef>p3_fn</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3_efn</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="p3_s" name="Radio transmits near the feeder">
<bpmn:outgoing>p3_f0</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:serviceTask id="p3_air" name="RF crosses up to ~30 m of drive (line-of-sight; bends and machines cut range)">
<bpmn:incoming>p3_f0</bpmn:incoming>
<bpmn:outgoing>p3_f1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p3_in" name="Couples into slots of ½″ radiating coax (foam dielectric, fire-retardant jacket)">
<bpmn:incoming>p3_f1</bpmn:incoming>
<bpmn:outgoing>p3_f2</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="p3_gj" name="Junction with crosscut, decline or ramp?">
<bpmn:incoming>p3_f2</bpmn:incoming>
<bpmn:outgoing>p3_f3</bpmn:outgoing>
<bpmn:outgoing>p3_f4</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="p3_sp" name="Passive splitter / directional coupler (2/3-way, 6/10/20 dB tap, DC-pass)">
<bpmn:incoming>p3_f4</bpmn:incoming>
<bpmn:outgoing>p3_f5</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="p3_gjm" name="">
<bpmn:incoming>p3_f3</bpmn:incoming>
<bpmn:incoming>p3_f5</bpmn:incoming>
<bpmn:outgoing>p3_f6</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="p3_con" name="Passes N-type connectors, splices, barrel joiners (sealed with tape + heat shrink)">
<bpmn:incoming>p3_f6</bpmn:incoming>
<bpmn:incoming>p3_f20</bpmn:incoming>
<bpmn:outgoing>p3_f7</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="p3_ga" name="Reached the next line amplifier? (~350–500 m)">
<bpmn:incoming>p3_f7</bpmn:incoming>
<bpmn:outgoing>p3_f8</bpmn:outgoing>
<bpmn:outgoing>p3_f9</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="p3_att" name="Cable loss lowers level; signal keeps travelling toward head of system">
<bpmn:incoming>p3_f9</bpmn:incoming>
<bpmn:outgoing>p3_f17</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p3_dip" name="Diplexer filters split uplink band from downlink band">
<bpmn:incoming>p3_f8</bpmn:incoming>
<bpmn:outgoing>p3_f10</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p3_gain" name="Uplink gain stage + AGC restores the level">
<bpmn:incoming>p3_f10</bpmn:incoming>
<bpmn:outgoing>p3_f11</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="p3_gh" name="Amplifier healthy? (LEDs, current draw, NMS transponder)">
<bpmn:incoming>p3_f11</bpmn:incoming>
<bpmn:outgoing>p3_f12</bpmn:outgoing>
<bpmn:outgoing>p3_f13</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="p3_ealm" name="Amp alarm to NMS → comms tech (p.7)">
<bpmn:incoming>p3_f13</bpmn:incoming>
<bpmn:messageEventDefinition id="p3_ealm_med"/>
</bpmn:endEvent>
<bpmn:exclusiveGateway id="p3_gc" name="More than ~15–20 amps in cascade?">
<bpmn:incoming>p3_f12</bpmn:incoming>
<bpmn:outgoing>p3_f14</bpmn:outgoing>
<bpmn:outgoing>p3_f15</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="p3_fn" name="Fibre node: RF → optical; fresh signal into a new feeder segment">
<bpmn:incoming>p3_f14</bpmn:incoming>
<bpmn:outgoing>p3_f16</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="p3_efn" name="Handed to fibre network (p.5)">
<bpmn:incoming>p3_f16</bpmn:incoming>
</bpmn:endEvent>
<bpmn:exclusiveGateway id="p3_gx" name="">
<bpmn:incoming>p3_f15</bpmn:incoming>
<bpmn:incoming>p3_f17</bpmn:incoming>
<bpmn:outgoing>p3_f18</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="p3_gh2" name="Reached head of system (riser)?">
<bpmn:incoming>p3_f18</bpmn:incoming>
<bpmn:outgoing>p3_f19</bpmn:outgoing>
<bpmn:outgoing>p3_f20</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="p3_eh" name="Hand to riser (p.5)">
<bpmn:incoming>p3_f19</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="p3_f0" name="" sourceRef="p3_s" targetRef="p3_air"/>
<bpmn:sequenceFlow id="p3_f1" name="" sourceRef="p3_air" targetRef="p3_in"/>
<bpmn:sequenceFlow id="p3_f2" name="" sourceRef="p3_in" targetRef="p3_gj"/>
<bpmn:sequenceFlow id="p3_f3" name="No" sourceRef="p3_gj" targetRef="p3_gjm"/>
<bpmn:sequenceFlow id="p3_f4" name="Yes" sourceRef="p3_gj" targetRef="p3_sp"/>
<bpmn:sequenceFlow id="p3_f5" name="" sourceRef="p3_sp" targetRef="p3_gjm"/>
<bpmn:sequenceFlow id="p3_f6" name="" sourceRef="p3_gjm" targetRef="p3_con"/>
<bpmn:sequenceFlow id="p3_f7" name="" sourceRef="p3_con" targetRef="p3_ga"/>
<bpmn:sequenceFlow id="p3_f8" name="Yes" sourceRef="p3_ga" targetRef="p3_dip"/>
<bpmn:sequenceFlow id="p3_f9" name="No" sourceRef="p3_ga" targetRef="p3_att"/>
<bpmn:sequenceFlow id="p3_f10" name="" sourceRef="p3_dip" targetRef="p3_gain"/>
<bpmn:sequenceFlow id="p3_f11" name="" sourceRef="p3_gain" targetRef="p3_gh"/>
<bpmn:sequenceFlow id="p3_f12" name="Yes" sourceRef="p3_gh" targetRef="p3_gc"/>
<bpmn:sequenceFlow id="p3_f13" name="No" sourceRef="p3_gh" targetRef="p3_ealm"/>
<bpmn:sequenceFlow id="p3_f14" name="Yes" sourceRef="p3_gc" targetRef="p3_fn"/>
<bpmn:sequenceFlow id="p3_f15" name="No" sourceRef="p3_gc" targetRef="p3_gx"/>
<bpmn:sequenceFlow id="p3_f16" name="" sourceRef="p3_fn" targetRef="p3_efn"/>
<bpmn:sequenceFlow id="p3_f17" name="" sourceRef="p3_att" targetRef="p3_gx"/>
<bpmn:sequenceFlow id="p3_f18" name="" sourceRef="p3_gx" targetRef="p3_gh2"/>
<bpmn:sequenceFlow id="p3_f19" name="Yes" sourceRef="p3_gh2" targetRef="p3_eh"/>
<bpmn:sequenceFlow id="p3_f20" name="No: next section" sourceRef="p3_gh2" targetRef="p3_con"/>
<bpmn:textAnnotation id="p3_a1"><bpmn:text>Hung on rock-bolt hangers every 1–3 m; catenary / messenger wire across voids; ID labels</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="p3_a1_as" sourceRef="p3_in" targetRef="p3_a1"/>
<bpmn:textAnnotation id="p3_a2"><bpmn:text>Far end of every branch: 50 Ω terminator or end-of-line antenna (stops reflections)</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="p3_a3"><bpmn:text>Amps powered by DC on the coax centre conductor (p.4)</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="p3_a3_as" sourceRef="p3_dip" targetRef="p3_a3"/>
<bpmn:textAnnotation id="p3_a4"><bpmn:text>Downlink is the reverse: headend → riser → amp downlink stages → slots radiate to every radio in range</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
