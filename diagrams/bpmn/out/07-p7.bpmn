<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="p7_defs" targetNamespace="http://example.com/od-radio">
<bpmn:collaboration id="p7_collab">
<bpmn:participant id="p7_pool" name="Comms technician fault finding" processRef="p7_process"/>
</bpmn:collaboration>
<bpmn:process id="p7_process" name="Fault finding" isExecutable="false">
<bpmn:laneSet id="p7_ls">
<bpmn:lane id="p7_T" name="Comms technician">
<bpmn:flowNodeRef>p7_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_one</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_head</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_walk</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_gc</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_gfm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_rt</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_gok</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_ven</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_etmp</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p7_N" name="Network management system">
<bpmn:flowNodeRef>p7_nms</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p7_U" name="Underground equipment">
<bpmn:flowNodeRef>p7_cut</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_wat</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_amp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_pwr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_fib</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_osc</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_gfx</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p7_D" name="Control room">
<bpmn:flowNodeRef>p7_cl</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7_end</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="p7_s" name="Fault reported (radio, NMS alarm, dead zone)">
<bpmn:outgoing>p7_f0</bpmn:outgoing>
<bpmn:messageEventDefinition id="p7_s_med"/>
</bpmn:startEvent>
<bpmn:exclusiveGateway id="p7_g1" name="Only one radio affected?">
<bpmn:incoming>p7_f0</bpmn:incoming>
<bpmn:outgoing>p7_f1</bpmn:outgoing>
<bpmn:outgoing>p7_f2</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:manualTask id="p7_one" name="Swap radio; check battery, antenna, channel; reprogram codeplug">
<bpmn:incoming>p7_f1</bpmn:incoming>
<bpmn:outgoing>p7_f20</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:exclusiveGateway id="p7_g2" name="Whole mine down?">
<bpmn:incoming>p7_f2</bpmn:incoming>
<bpmn:outgoing>p7_f3</bpmn:outgoing>
<bpmn:outgoing>p7_f4</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:manualTask id="p7_head" name="Check headend: repeaters, combiner, duplexer, headend amp, UPS, gateway">
<bpmn:incoming>p7_f3</bpmn:incoming>
<bpmn:outgoing>p7_f21</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:serviceTask id="p7_nms" name="NMS shows the last amplifier still reporting OK">
<bpmn:incoming>p7_f4</bpmn:incoming>
<bpmn:outgoing>p7_f5</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:manualTask id="p7_walk" name="Walk the cable from the last good amp with signal meter / spectrum analyser">
<bpmn:incoming>p7_f5</bpmn:incoming>
<bpmn:outgoing>p7_f6</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:exclusiveGateway id="p7_gc" name="What is the cause?">
<bpmn:incoming>p7_f6</bpmn:incoming>
<bpmn:outgoing>p7_f7</bpmn:outgoing>
<bpmn:outgoing>p7_f8</bpmn:outgoing>
<bpmn:outgoing>p7_f9</bpmn:outgoing>
<bpmn:outgoing>p7_f10</bpmn:outgoing>
<bpmn:outgoing>p7_f11</bpmn:outgoing>
<bpmn:outgoing>p7_f12</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:manualTask id="p7_cut" name="Cable cut / crushed: splice or new length + 2 N-connectors; re-hang">
<bpmn:incoming>p7_f7</bpmn:incoming>
<bpmn:outgoing>p7_f13</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:manualTask id="p7_wat" name="Water in connector / amp: cut back, re-terminate, re-seal">
<bpmn:incoming>p7_f8</bpmn:incoming>
<bpmn:outgoing>p7_f14</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:manualTask id="p7_amp" name="Dead amp / blown fuse: find the downstream short, then swap amp">
<bpmn:incoming>p7_f9</bpmn:incoming>
<bpmn:outgoing>p7_f15</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:manualTask id="p7_pwr" name="PSU / mains / UPS failure: electrician restores supply; new batteries">
<bpmn:incoming>p7_f10</bpmn:incoming>
<bpmn:outgoing>p7_f16</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:manualTask id="p7_fib" name="Fibre node or switch fault: swap module; OTDR test; re-splice">
<bpmn:incoming>p7_f11</bpmn:incoming>
<bpmn:outgoing>p7_f17</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:manualTask id="p7_osc" name="Amp oscillation / overload: fit missing terminator; rebalance gains">
<bpmn:incoming>p7_f12</bpmn:incoming>
<bpmn:outgoing>p7_f18</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:exclusiveGateway id="p7_gfx" name="">
<bpmn:incoming>p7_f13</bpmn:incoming>
<bpmn:incoming>p7_f14</bpmn:incoming>
<bpmn:incoming>p7_f15</bpmn:incoming>
<bpmn:incoming>p7_f16</bpmn:incoming>
<bpmn:incoming>p7_f17</bpmn:incoming>
<bpmn:incoming>p7_f18</bpmn:incoming>
<bpmn:outgoing>p7_f19</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="p7_gfm" name="">
<bpmn:incoming>p7_f19</bpmn:incoming>
<bpmn:incoming>p7_f20</bpmn:incoming>
<bpmn:incoming>p7_f21</bpmn:incoming>
<bpmn:outgoing>p7_f22</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:manualTask id="p7_rt" name="Radio check from the far end of the section">
<bpmn:incoming>p7_f22</bpmn:incoming>
<bpmn:outgoing>p7_f23</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:exclusiveGateway id="p7_gok" name="Fault cleared?">
<bpmn:incoming>p7_f23</bpmn:incoming>
<bpmn:outgoing>p7_f24</bpmn:outgoing>
<bpmn:outgoing>p7_f25</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:manualTask id="p7_ven" name="Escalate to vendor; deploy portable repeater as a stop-gap">
<bpmn:incoming>p7_f25</bpmn:incoming>
<bpmn:outgoing>p7_f26</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:endEvent id="p7_etmp" name="Temporary coverage in place">
<bpmn:incoming>p7_f26</bpmn:incoming>
</bpmn:endEvent>
<bpmn:userTask id="p7_cl" name="Update coverage map; close fault; tell crews">
<bpmn:incoming>p7_f24</bpmn:incoming>
<bpmn:outgoing>p7_f27</bpmn:outgoing>
</bpmn:userTask>
<bpmn:endEvent id="p7_end" name="Fault closed">
<bpmn:incoming>p7_f27</bpmn:incoming>
</bpmn:endEvent>
