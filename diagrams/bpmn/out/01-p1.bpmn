<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="p1_defs" targetNamespace="http://example.com/od-radio">
<bpmn:collaboration id="p1_collab">
<bpmn:participant id="p1_pool" name="Olympic Dam underground radio network" processRef="p1_process"/>
<bpmn:participant id="bb_tech" name="Comms technician (fault finding, p.7)"/>
<bpmn:participant id="bb_surf" name="Surface radio users (supervisors, ERT, surface fleet)"/>
<bpmn:messageFlow id="p1_m0" name="Fault report" sourceRef="m_eft" targetRef="bb_tech"/>
<bpmn:messageFlow id="p1_m1" name="Voice on surface channel" sourceRef="m_sur" targetRef="bb_surf"/>
</bpmn:collaboration>
<bpmn:process id="p1_process" name="Underground radio call, end to end" isExecutable="false">
<bpmn:laneSet id="p1_ls">
<bpmn:lane id="p1_W" name="Underground worker / machine">
<bpmn:flowNodeRef>m_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_pre</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_gok</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_enr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_ptt</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_gh</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_eok</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_eft</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p1_F" name="Field radio equipment">
<bpmn:flowNodeRef>m_gem</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_tx</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_txe</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_gm1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_rx</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p1_C" name="Coverage at the work area">
<bpmn:flowNodeRef>m_gdev</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_gnear</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_ap</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_gtail</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_tail</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_enc</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p1_L" name="Leaky-feeder distribution">
<bpmn:flowNodeRef>m_gm2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_lf</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_gfn</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_dlf</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p1_N" name="Fibre &amp; IP network">
<bpmn:flowNodeRef>m_fib</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_srv</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_eds</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p1_S" name="Shaft / decline riser">
<bpmn:flowNodeRef>m_ris</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p1_H" name="Surface headend">
<bpmn:flowNodeRef>m_gm3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_hp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_gd</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_gm4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_dl</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p1_D" name="Control room / dispatch">
<bpmn:flowNodeRef>m_con</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_ge</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_em</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_eem</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_gp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_ans</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_gans</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_esc</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p1_T" name="Surface towers">
<bpmn:flowNodeRef>m_sur</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_esu</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="m_s" name="Need to talk or send data">
<bpmn:outgoing>p1_f0</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:callActivity id="m_pre" name="Pre-use radio checks (p.2)" calledElement="p2_process">
<bpmn:incoming>p1_f0</bpmn:incoming>
<bpmn:outgoing>p1_f1</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:exclusiveGateway id="m_gok" name="Radio passed checks?">
<bpmn:incoming>p1_f1</bpmn:incoming>
<bpmn:outgoing>p1_f2</bpmn:outgoing>
<bpmn:outgoing>p1_f3</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="m_enr" name="Not cleared: take a spare radio">
<bpmn:incoming>p1_f3</bpmn:incoming>
</bpmn:endEvent>
<bpmn:userTask id="m_ptt" name="Press PTT and speak (or device sends data)">
<bpmn:incoming>p1_f2</bpmn:incoming>
<bpmn:outgoing>p1_f4</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="m_gem" name="Emergency button or man-down?">
<bpmn:incoming>p1_f4</bpmn:incoming>
<bpmn:outgoing>p1_f5</bpmn:outgoing>
<bpmn:outgoing>p1_f6</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="m_tx" name="Transmit: handheld, vehicle radio, loco modem, tracking tag or gas detector">
<bpmn:incoming>p1_f5</bpmn:incoming>
<bpmn:outgoing>p1_f7</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="m_txe" name="Send emergency alert: priority, radio ID, location">
<bpmn:incoming>p1_f6</bpmn:incoming>
<bpmn:outgoing>p1_f8</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="m_gm1" name="">
<bpmn:incoming>p1_f7</bpmn:incoming>
<bpmn:incoming>p1_f8</bpmn:incoming>
<bpmn:outgoing>p1_f9</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="m_gdev" name="Broadband device (Wi-Fi / LTE)?">
<bpmn:incoming>p1_f9</bpmn:incoming>
<bpmn:outgoing>p1_f10</bpmn:outgoing>
<bpmn:outgoing>p1_f11</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="m_gnear" name="Within 10–30 m line-of-sight of the leaky feeder?">
<bpmn:incoming>p1_f10</bpmn:incoming>
<bpmn:outgoing>p1_f12</bpmn:outgoing>
<bpmn:outgoing>p1_f13</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="m_ap" name="Wi-Fi AP / private LTE small cell receives (PoE, panel antennas)">
<bpmn:incoming>p1_f11</bpmn:incoming>
<bpmn:outgoing>p1_f21</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="m_gtail" name="Antenna tail or portable repeater in the stope?">
<bpmn:incoming>p1_f13</bpmn:incoming>
<bpmn:outgoing>p1_f14</bpmn:outgoing>
<bpmn:outgoing>p1_f15</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="m_tail" name="Antenna tail (coupler, jumper, panel/Yagi) or portable repeater couples signal in">
<bpmn:incoming>p1_f14</bpmn:incoming>
<bpmn:outgoing>p1_f16</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="m_enc" name="No coverage: move to main drive and retry">
<bpmn:incoming>p1_f15</bpmn:incoming>
</bpmn:endEvent>
<bpmn:exclusiveGateway id="m_gm2" name="">
<bpmn:incoming>p1_f12</bpmn:incoming>
<bpmn:incoming>p1_f16</bpmn:incoming>
<bpmn:outgoing>p1_f17</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="m_lf" name="Uplink along leaky feeder: radiating coax, couplers, line amps (p.3)" calledElement="p3_process">
<bpmn:incoming>p1_f17</bpmn:incoming>
<bpmn:outgoing>p1_f18</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:exclusiveGateway id="m_gfn" name="Fibre node in this path?">
<bpmn:incoming>p1_f18</bpmn:incoming>
<bpmn:outgoing>p1_f19</bpmn:outgoing>
<bpmn:outgoing>p1_f20</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="m_fib" name="Fibre &amp; IP transport and riser to surface (p.5)" calledElement="p5_process">
<bpmn:incoming>p1_f19</bpmn:incoming>
<bpmn:incoming>p1_f21</bpmn:incoming>
<bpmn:outgoing>p1_f22</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:serviceTask id="m_ris" name="RF coax rises via shaft or decline riser (p.5)">
<bpmn:incoming>p1_f20</bpmn:incoming>
<bpmn:outgoing>p1_f23</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="m_gm3" name="">
<bpmn:incoming>p1_f22</bpmn:incoming>
<bpmn:incoming>p1_f23</bpmn:incoming>
<bpmn:outgoing>p1_f24</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="m_hp" name="Headend: repeaters, combiner, duplexer, trunking controller (p.6)" calledElement="p6_process">
<bpmn:incoming>p1_f24</bpmn:incoming>
<bpmn:outgoing>p1_f25</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:inclusiveGateway id="m_gd" name="Send to every destination that applies">
<bpmn:incoming>p1_f25</bpmn:incoming>
<bpmn:outgoing>p1_f26</bpmn:outgoing>
<bpmn:outgoing>p1_f27</bpmn:outgoing>
<bpmn:outgoing>p1_f28</bpmn:outgoing>
</bpmn:inclusiveGateway>
<bpmn:serviceTask id="m_srv" name="Application servers: tracking, train control (ATO), SCADA, fleet management">
<bpmn:incoming>p1_f26</bpmn:incoming>
<bpmn:outgoing>p1_f29</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="m_eds" name="Data delivered">
<bpmn:incoming>p1_f29</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="m_con" name="Dispatch console receives call; voice logger records it">
<bpmn:incoming>p1_f28</bpmn:incoming>
<bpmn:outgoing>p1_f30</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="m_ge" name="Emergency alert?">
<bpmn:incoming>p1_f30</bpmn:incoming>
<bpmn:outgoing>p1_f31</bpmn:outgoing>
<bpmn:outgoing>p1_f32</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="m_em" name="Emergency response and backup comms (p.8)" calledElement="p8_process">
<bpmn:incoming>p1_f31</bpmn:incoming>
<bpmn:outgoing>p1_f33</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:endEvent id="m_eem" name="Incident managed">
<bpmn:incoming>p1_f33</bpmn:incoming>
</bpmn:endEvent>
<bpmn:exclusiveGateway id="m_gp" name="Talkgroup patched to surface?">
<bpmn:incoming>p1_f32</bpmn:incoming>
<bpmn:outgoing>p1_f34</bpmn:outgoing>
<bpmn:outgoing>p1_f35</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="m_sur" name="Surface towers and wide-area radio (p.9)" calledElement="p9_process">
<bpmn:incoming>p1_f34</bpmn:incoming>
<bpmn:outgoing>p1_f36</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:endEvent id="m_esu" name="Heard by surface users">
<bpmn:incoming>p1_f36</bpmn:incoming>
</bpmn:endEvent>
<bpmn:userTask id="m_ans" name="Controller answers (desk mic / footswitch)">
<bpmn:incoming>p1_f35</bpmn:incoming>
<bpmn:outgoing>p1_f37</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="m_gans" name="Answered in time?">
<bpmn:incoming>p1_f37</bpmn:incoming>
<bpmn:outgoing>p1_f38</bpmn:outgoing>
<bpmn:outgoing>p1_f39</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:manualTask id="m_esc" name="Escalate: backup controller or supervisor phone">
<bpmn:incoming>p1_f39</bpmn:incoming>
<bpmn:outgoing>p1_f40</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:exclusiveGateway id="m_gm4" name="">
<bpmn:incoming>p1_f27</bpmn:incoming>
<bpmn:incoming>p1_f38</bpmn:incoming>
<bpmn:incoming>p1_f40</bpmn:incoming>
<bpmn:outgoing>p1_f41</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="m_dl" name="Transmit on downlink: repeater → combiner → duplexer → headend amp">
<bpmn:incoming>p1_f41</bpmn:incoming>
<bpmn:outgoing>p1_f42</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="m_dlf" name="Downlink runs down riser and leaky feeder; amps boost; slots radiate">
<bpmn:incoming>p1_f42</bpmn:incoming>
<bpmn:outgoing>p1_f43</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="m_rx" name="Radio receives and plays audio (speaker / speaker-mic)">
<bpmn:incoming>p1_f43</bpmn:incoming>
<bpmn:outgoing>p1_f44</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="m_gh" name="Reply heard clearly?">
<bpmn:incoming>p1_f44</bpmn:incoming>
<bpmn:outgoing>p1_f45</bpmn:outgoing>
<bpmn:outgoing>p1_f46</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="m_eok" name="Communication complete">
<bpmn:incoming>p1_f45</bpmn:incoming>
</bpmn:endEvent>
<bpmn:endEvent id="m_eft" name="Report fault">
<bpmn:incoming>p1_f46</bpmn:incoming>
<bpmn:messageEventDefinition id="m_eft_med"/>
</bpmn:endEvent>
