<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="p2_defs" targetNamespace="http://example.com/od-radio">
<bpmn:collaboration id="p2_collab">
<bpmn:participant id="p2_pool" name="Pre-use radio checks" processRef="p2_process"/>
</bpmn:collaboration>
<bpmn:process id="p2_process" name="Pre-use radio checks" isExecutable="false">
<bpmn:laneSet id="p2_ls">
<bpmn:lane id="p2_W" name="Underground worker">
<bpmn:flowNodeRef>p2_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_gk</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_ant</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_ga</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_rep</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_gam</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_ch</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_gmv</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_rc</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_eok</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p2_K" name="Lamp room / charger rack">
<bpmn:flowNodeRef>p2_take</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_swap</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p2_R" name="Radio (handheld or vehicle)">
<bpmn:flowNodeRef>p2_veh</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_pwr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_gv</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_gb</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_vfix</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_ev</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_gbm</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p2_D" name="Control room">
<bpmn:flowNodeRef>p2_ack</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_gr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2_ebad</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="p2_s" name="Start of shift">
<bpmn:outgoing>p2_f0</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:exclusiveGateway id="p2_gk" name="Handheld or vehicle radio?">
<bpmn:incoming>p2_f0</bpmn:incoming>
<bpmn:outgoing>p2_f1</bpmn:outgoing>
<bpmn:outgoing>p2_f2</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:manualTask id="p2_take" name="Take handheld from the multi-unit charger rack">
<bpmn:incoming>p2_f1</bpmn:incoming>
<bpmn:outgoing>p2_f3</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:serviceTask id="p2_veh" name="Vehicle radio: ignition sense, inline fuse, DC-DC converter, roof antenna, coax jumper">
<bpmn:incoming>p2_f2</bpmn:incoming>
<bpmn:outgoing>p2_f4</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p2_pwr" name="Power on: Li-ion battery pack, channel knob, display">
<bpmn:incoming>p2_f3</bpmn:incoming>
<bpmn:outgoing>p2_f8</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="p2_gv" name="Vehicle radio working?">
<bpmn:incoming>p2_f4</bpmn:incoming>
<bpmn:outgoing>p2_f5</bpmn:outgoing>
<bpmn:outgoing>p2_f6</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="p2_gb" name="Powers on and battery charged?">
<bpmn:incoming>p2_f8</bpmn:incoming>
<bpmn:outgoing>p2_f9</bpmn:outgoing>
<bpmn:outgoing>p2_f10</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:manualTask id="p2_vfix" name="Fit-out tech repairs; driver carries a handheld meanwhile">
<bpmn:incoming>p2_f6</bpmn:incoming>
<bpmn:outgoing>p2_f7</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:manualTask id="p2_swap" name="Swap battery pack from charger; tag faulty pack">
<bpmn:incoming>p2_f10</bpmn:incoming>
<bpmn:outgoing>p2_f11</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:endEvent id="p2_ev" name="Vehicle radio tagged out">
<bpmn:incoming>p2_f7</bpmn:incoming>
</bpmn:endEvent>
<bpmn:exclusiveGateway id="p2_gbm" name="">
<bpmn:incoming>p2_f9</bpmn:incoming>
<bpmn:incoming>p2_f11</bpmn:incoming>
<bpmn:outgoing>p2_f12</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:manualTask id="p2_ant" name="Inspect antenna (SMA), speaker-mic cable, PTT, emergency button, belt clip, IS label">
<bpmn:incoming>p2_f12</bpmn:incoming>
<bpmn:outgoing>p2_f13</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:exclusiveGateway id="p2_ga" name="All intact and tight?">
<bpmn:incoming>p2_f13</bpmn:incoming>
<bpmn:outgoing>p2_f14</bpmn:outgoing>
<bpmn:outgoing>p2_f15</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:manualTask id="p2_rep" name="Replace antenna or accessory from comms store">
<bpmn:incoming>p2_f15</bpmn:incoming>
<bpmn:outgoing>p2_f16</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:exclusiveGateway id="p2_gam" name="">
<bpmn:incoming>p2_f14</bpmn:incoming>
<bpmn:incoming>p2_f16</bpmn:incoming>
<bpmn:outgoing>p2_f17</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="p2_ch" name="Select underground leaky-feeder channel / talkgroup">
<bpmn:incoming>p2_f17</bpmn:incoming>
<bpmn:outgoing>p2_f18</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="p2_gmv" name="">
<bpmn:incoming>p2_f5</bpmn:incoming>
<bpmn:incoming>p2_f18</bpmn:incoming>
<bpmn:outgoing>p2_f19</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="p2_rc" name="Radio check with control at portal or shaft collar">
<bpmn:incoming>p2_f19</bpmn:incoming>
<bpmn:outgoing>p2_f20</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="p2_ack" name="Controller acknowledges and reports readability">
<bpmn:incoming>p2_f20</bpmn:incoming>
<bpmn:outgoing>p2_f21</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="p2_gr" name="Heard clearly both ways?">
<bpmn:incoming>p2_f21</bpmn:incoming>
<bpmn:outgoing>p2_f22</bpmn:outgoing>
<bpmn:outgoing>p2_f23</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="p2_eok" name="Cleared to go underground">
<bpmn:incoming>p2_f22</bpmn:incoming>
</bpmn:endEvent>
<bpmn:endEvent id="p2_ebad" name="Do not enter: radio fault reported">
<bpmn:incoming>p2_f23</bpmn:incoming>
<bpmn:messageEventDefinition id="p2_ebad_med"/>
</bpmn:endEvent>
<bpmn:sequenceFlow id="p2_f0" name="" sourceRef="p2_s" targetRef="p2_gk"/>
<bpmn:sequenceFlow id="p2_f1" name="Handheld" sourceRef="p2_gk" targetRef="p2_take"/>
<bpmn:sequenceFlow id="p2_f2" name="Vehicle" sourceRef="p2_gk" targetRef="p2_veh"/>
<bpmn:sequenceFlow id="p2_f3" name="" sourceRef="p2_take" targetRef="p2_pwr"/>
<bpmn:sequenceFlow id="p2_f4" name="" sourceRef="p2_veh" targetRef="p2_gv"/>
<bpmn:sequenceFlow id="p2_f5" name="Yes" sourceRef="p2_gv" targetRef="p2_gmv"/>
<bpmn:sequenceFlow id="p2_f6" name="No" sourceRef="p2_gv" targetRef="p2_vfix"/>
<bpmn:sequenceFlow id="p2_f7" name="" sourceRef="p2_vfix" targetRef="p2_ev"/>
<bpmn:sequenceFlow id="p2_f8" name="" sourceRef="p2_pwr" targetRef="p2_gb"/>
<bpmn:sequenceFlow id="p2_f9" name="Yes" sourceRef="p2_gb" targetRef="p2_gbm"/>
<bpmn:sequenceFlow id="p2_f10" name="No" sourceRef="p2_gb" targetRef="p2_swap"/>
<bpmn:sequenceFlow id="p2_f11" name="" sourceRef="p2_swap" targetRef="p2_gbm"/>
<bpmn:sequenceFlow id="p2_f12" name="" sourceRef="p2_gbm" targetRef="p2_ant"/>
<bpmn:sequenceFlow id="p2_f13" name="" sourceRef="p2_ant" targetRef="p2_ga"/>
<bpmn:sequenceFlow id="p2_f14" name="Yes" sourceRef="p2_ga" targetRef="p2_gam"/>
<bpmn:sequenceFlow id="p2_f15" name="No" sourceRef="p2_ga" targetRef="p2_rep"/>
<bpmn:sequenceFlow id="p2_f16" name="" sourceRef="p2_rep" targetRef="p2_gam"/>
<bpmn:sequenceFlow id="p2_f17" name="" sourceRef="p2_gam" targetRef="p2_ch"/>
<bpmn:sequenceFlow id="p2_f18" name="" sourceRef="p2_ch" targetRef="p2_gmv"/>
<bpmn:sequenceFlow id="p2_f19" name="" sourceRef="p2_gmv" targetRef="p2_rc"/>
<bpmn:sequenceFlow id="p2_f20" name="" sourceRef="p2_rc" targetRef="p2_ack"/>
<bpmn:sequenceFlow id="p2_f21" name="" sourceRef="p2_ack" targetRef="p2_gr"/>
<bpmn:sequenceFlow id="p2_f22" name="Yes" sourceRef="p2_gr" targetRef="p2_eok"/>
<bpmn:sequenceFlow id="p2_f23" name="No" sourceRef="p2_gr" targetRef="p2_ebad"/>
<bpmn:textAnnotation id="p2_a1"><bpmn:text>Surface simplex channels do not reach underground</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="p2_a1_as" sourceRef="p2_ch" targetRef="p2_a1"/>
</bpmn:process>
