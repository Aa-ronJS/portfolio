<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="p8_defs" targetNamespace="http://example.com/od-radio">
<bpmn:collaboration id="p8_collab">
<bpmn:participant id="p8_pool" name="Emergency communications" processRef="p8_process"/>
</bpmn:collaboration>
<bpmn:process id="p8_process" name="Emergency response and backup comms" isExecutable="false">
<bpmn:laneSet id="p8_ls">
<bpmn:lane id="p8_W" name="Underground worker">
<bpmn:flowNodeRef>p8_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p8_pr</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p8_R" name="Field radio">
<bpmn:flowNodeRef>p8_al</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p8_D" name="Control room">
<bpmn:flowNodeRef>p8_alm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p8_act</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p8_glf</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p8_man</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p8_gend</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p8_e</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p8_E" name="ERT / mines rescue">
<bpmn:flowNodeRef>p8_mob</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p8_res</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p8_B" name="Backup comms systems">
<bpmn:flowNodeRef>p8_gb</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p8_tte</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p8_ref</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p8_ph</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p8_st</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p8_self</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p8_gbm</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="p8_s" name="Worker in danger (or man-down tilt trips)">
<bpmn:outgoing>p8_f0</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:userTask id="p8_pr" name="Press the orange emergency button">
<bpmn:incoming>p8_f0</bpmn:incoming>
<bpmn:outgoing>p8_f1</bpmn:outgoing>
</bpmn:userTask>
<bpmn:serviceTask id="p8_al" name="Radio sends emergency: pre-empts channel, radio ID, last location, hot mic">
<bpmn:incoming>p8_f1</bpmn:incoming>
<bpmn:outgoing>p8_f2</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p8_alm" name="Console alarm; tracking display shows location">
<bpmn:incoming>p8_f2</bpmn:incoming>
<bpmn:outgoing>p8_f3</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="p8_act" name="Declare emergency; broadcast on all talkgroups; call out ERT">
<bpmn:incoming>p8_f3</bpmn:incoming>
<bpmn:outgoing>p8_f4</bpmn:outgoing>
</bpmn:userTask>
<bpmn:manualTask id="p8_mob" name="ERT / mines rescue mobilise">
<bpmn:incoming>p8_f4</bpmn:incoming>
<bpmn:outgoing>p8_f5</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:exclusiveGateway id="p8_glf" name="Leaky feeder working in the incident area?">
<bpmn:incoming>p8_f5</bpmn:incoming>
<bpmn:outgoing>p8_f6</bpmn:outgoing>
<bpmn:outgoing>p8_f7</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="p8_man" name="Manage the incident over radio">
<bpmn:incoming>p8_f6</bpmn:incoming>
<bpmn:outgoing>p8_f19</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="p8_gb" name="Which backup reaches them?">
<bpmn:incoming>p8_f7</bpmn:incoming>
<bpmn:outgoing>p8_f8</bpmn:outgoing>
<bpmn:outgoing>p8_f9</bpmn:outgoing>
<bpmn:outgoing>p8_f10</bpmn:outgoing>
<bpmn:outgoing>p8_f11</bpmn:outgoing>
<bpmn:outgoing>p8_f12</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="p8_tte" name="Through-the-earth paging: surface VLF loop → cap-lamp receivers flash + text">
<bpmn:incoming>p8_f8</bpmn:incoming>
<bpmn:outgoing>p8_f13</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p8_ref" name="Refuge chamber: hard-wired / fibre phone, own feeder tail, battery radio">
<bpmn:incoming>p8_f9</bpmn:incoming>
<bpmn:outgoing>p8_f14</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p8_ph" name="Fixed underground phones (crib rooms, workshops, shaft and pump stations)">
<bpmn:incoming>p8_f10</bpmn:incoming>
<bpmn:outgoing>p8_f15</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p8_st" name="Stench gas into ventilation and compressed air (evacuate)">
<bpmn:incoming>p8_f11</bpmn:incoming>
<bpmn:outgoing>p8_f16</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:manualTask id="p8_self" name="Nothing reaches them: self-escape or enter refuge per TARP">
<bpmn:incoming>p8_f12</bpmn:incoming>
<bpmn:outgoing>p8_f17</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:exclusiveGateway id="p8_gbm" name="">
<bpmn:incoming>p8_f13</bpmn:incoming>
<bpmn:incoming>p8_f14</bpmn:incoming>
<bpmn:incoming>p8_f15</bpmn:incoming>
<bpmn:incoming>p8_f16</bpmn:incoming>
<bpmn:incoming>p8_f17</bpmn:incoming>
<bpmn:outgoing>p8_f18</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:manualTask id="p8_res" name="Locate and recover workers using last tracked location">
<bpmn:incoming>p8_f18</bpmn:incoming>
<bpmn:outgoing>p8_f20</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:exclusiveGateway id="p8_gend" name="">
<bpmn:incoming>p8_f19</bpmn:incoming>
<bpmn:incoming>p8_f20</bpmn:incoming>
<bpmn:outgoing>p8_f21</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="p8_e" name="Incident resolved; logs and recordings reviewed">
<bpmn:incoming>p8_f21</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="p8_f0" name="" sourceRef="p8_s" targetRef="p8_pr"/>
<bpmn:sequenceFlow id="p8_f1" name="" sourceRef="p8_pr" targetRef="p8_al"/>
<bpmn:sequenceFlow id="p8_f2" name="" sourceRef="p8_al" targetRef="p8_alm"/>
<bpmn:sequenceFlow id="p8_f3" name="" sourceRef="p8_alm" targetRef="p8_act"/>
<bpmn:sequenceFlow id="p8_f4" name="" sourceRef="p8_act" targetRef="p8_mob"/>
<bpmn:sequenceFlow id="p8_f5" name="" sourceRef="p8_mob" targetRef="p8_glf"/>
<bpmn:sequenceFlow id="p8_f6" name="Yes" sourceRef="p8_glf" targetRef="p8_man"/>
<bpmn:sequenceFlow id="p8_f7" name="No" sourceRef="p8_glf" targetRef="p8_gb"/>
<bpmn:sequenceFlow id="p8_f8" name="TTE" sourceRef="p8_gb" targetRef="p8_tte"/>
<bpmn:sequenceFlow id="p8_f9" name="In refuge" sourceRef="p8_gb" targetRef="p8_ref"/>
<bpmn:sequenceFlow id="p8_f10" name="Near a phone" sourceRef="p8_gb" targetRef="p8_ph"/>
<bpmn:sequenceFlow id="p8_f11" name="Mass alert" sourceRef="p8_gb" targetRef="p8_st"/>
<bpmn:sequenceFlow id="p8_f12" name="None" sourceRef="p8_gb" targetRef="p8_self"/>
<bpmn:sequenceFlow id="p8_f13" name="" sourceRef="p8_tte" targetRef="p8_gbm"/>
<bpmn:sequenceFlow id="p8_f14" name="" sourceRef="p8_ref" targetRef="p8_gbm"/>
<bpmn:sequenceFlow id="p8_f15" name="" sourceRef="p8_ph" targetRef="p8_gbm"/>
<bpmn:sequenceFlow id="p8_f16" name="" sourceRef="p8_st" targetRef="p8_gbm"/>
<bpmn:sequenceFlow id="p8_f17" name="" sourceRef="p8_self" targetRef="p8_gbm"/>
<bpmn:sequenceFlow id="p8_f18" name="" sourceRef="p8_gbm" targetRef="p8_res"/>
<bpmn:sequenceFlow id="p8_f19" name="" sourceRef="p8_man" targetRef="p8_gend"/>
<bpmn:sequenceFlow id="p8_f20" name="" sourceRef="p8_res" targetRef="p8_gend"/>
<bpmn:sequenceFlow id="p8_f21" name="" sourceRef="p8_gend" targetRef="p8_e"/>
</bpmn:process>
