<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="p9_defs" targetNamespace="http://example.com/od-radio">
<bpmn:collaboration id="p9_collab">
<bpmn:participant id="p9_pool" name="Surface wide-area radio" processRef="p9_process"/>
</bpmn:collaboration>
<bpmn:process id="p9_process" name="Surface towers and wide-area radio" isExecutable="false">
<bpmn:laneSet id="p9_ls">
<bpmn:lane id="p9_G" name="Radio interconnect gateway">
<bpmn:flowNodeRef>p9_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p9_gw</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p9_bh</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p9_T" name="Tower &amp; RF">
<bpmn:flowNodeRef>p9_rep</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p9_fd</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p9_an</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p9_gs</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p9_gsm</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p9_L" name="Lightning &amp; earthing">
<bpmn:flowNodeRef>p9_fx</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p9_U" name="Surface radio users">
<bpmn:flowNodeRef>p9_rx</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p9_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="p9_s" name="Talkgroup patched to surface">
<bpmn:outgoing>p9_f0</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:serviceTask id="p9_gw" name="RoIP gateway bridges the underground talkgroup to a surface channel">
<bpmn:incoming>p9_f0</bpmn:incoming>
<bpmn:outgoing>p9_f1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p9_bh" name="Fibre / microwave backhaul to the tower site">
<bpmn:incoming>p9_f1</bpmn:incoming>
<bpmn:outgoing>p9_f2</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p9_rep" name="Surface repeater / LTE eNodeB transmits">
<bpmn:incoming>p9_f2</bpmn:incoming>
<bpmn:outgoing>p9_f3</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p9_fd" name="7/8″ or 1-5/8″ heliax feeder, earthing kits, hoisting grip, wall entry plate">
<bpmn:incoming>p9_f3</bpmn:incoming>
<bpmn:outgoing>p9_f4</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p9_an" name="Tower antennas: omni collinear (VHF/UHF), LTE sector panels, Yagi links">
<bpmn:incoming>p9_f4</bpmn:incoming>
<bpmn:outgoing>p9_f5</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="p9_gs" name="Storm damage or high VSWR?">
<bpmn:incoming>p9_f5</bpmn:incoming>
<bpmn:outgoing>p9_f6</bpmn:outgoing>
<bpmn:outgoing>p9_f7</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:manualTask id="p9_fx" name="Replace surge arrestor cartridges; test earth grid (&lt;10 Ω); sweep feeder">
<bpmn:incoming>p9_f7</bpmn:incoming>
<bpmn:outgoing>p9_f8</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:exclusiveGateway id="p9_gsm" name="">
<bpmn:incoming>p9_f6</bpmn:incoming>
<bpmn:incoming>p9_f8</bpmn:incoming>
<bpmn:outgoing>p9_f9</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="p9_rx" name="Surface radios receive: supervisors, ERT, shift boss, surface fleet">
<bpmn:incoming>p9_f9</bpmn:incoming>
<bpmn:outgoing>p9_f10</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="p9_e" name="Heard on surface">
<bpmn:incoming>p9_f10</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="p9_f0" name="" sourceRef="p9_s" targetRef="p9_gw"/>
<bpmn:sequenceFlow id="p9_f1" name="" sourceRef="p9_gw" targetRef="p9_bh"/>
<bpmn:sequenceFlow id="p9_f2" name="" sourceRef="p9_bh" targetRef="p9_rep"/>
<bpmn:sequenceFlow id="p9_f3" name="" sourceRef="p9_rep" targetRef="p9_fd"/>
<bpmn:sequenceFlow id="p9_f4" name="" sourceRef="p9_fd" targetRef="p9_an"/>
<bpmn:sequenceFlow id="p9_f5" name="" sourceRef="p9_an" targetRef="p9_gs"/>
<bpmn:sequenceFlow id="p9_f6" name="No" sourceRef="p9_gs" targetRef="p9_gsm"/>
<bpmn:sequenceFlow id="p9_f7" name="Yes" sourceRef="p9_gs" targetRef="p9_fx"/>
<bpmn:sequenceFlow id="p9_f8" name="" sourceRef="p9_fx" targetRef="p9_gsm"/>
<bpmn:sequenceFlow id="p9_f9" name="" sourceRef="p9_gsm" targetRef="p9_rx"/>
<bpmn:sequenceFlow id="p9_f10" name="" sourceRef="p9_rx" targetRef="p9_e"/>
<bpmn:textAnnotation id="p9_a1"><bpmn:text>Tower: lattice or monopole, climbing ladder + fall arrest, aviation obstruction light</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="p9_a1_as" sourceRef="p9_rep" targetRef="p9_a1"/>
<bpmn:textAnnotation id="p9_a2"><bpmn:text>Lightning protection: air terminal, down conductor, coax surge arrestors, earth grid</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
