<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="p6_defs" targetNamespace="http://example.com/od-radio">
<bpmn:collaboration id="p6_collab">
<bpmn:participant id="p6_pool" name="Surface headend" processRef="p6_process"/>
</bpmn:collaboration>
<bpmn:process id="p6_process" name="Headend processing" isExecutable="false">
<bpmn:laneSet id="p6_ls">
<bpmn:lane id="p6_I" name="Headend RF interface">
<bpmn:flowNodeRef>p6_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_ha</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_att</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_dup</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_dup2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_e</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p6_X" name="Receive chain">
<bpmn:flowNodeRef>p6_mc</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p6_Q" name="Repeaters &amp; controller">
<bpmn:flowNodeRef>p6_rpt</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_gr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_hs</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_grm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_ctl</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_ge</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_pre</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_gem</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_rt</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_gd</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_eno</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="p6_Y" name="Transmit chain">
<bpmn:flowNodeRef>p6_rtx</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6_comb</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="p6_s" name="Uplink arrives at surface">
<bpmn:outgoing>p6_f0</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:serviceTask id="p6_ha" name="Headend amplifier separates uplink / downlink; sets feeder levels">
<bpmn:incoming>p6_f0</bpmn:incoming>
<bpmn:outgoing>p6_f1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p6_att" name="Variable attenuators and band-pass filters (balance, reject interference)">
<bpmn:incoming>p6_f1</bpmn:incoming>
<bpmn:outgoing>p6_f2</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p6_dup" name="Duplexer passes the receive band to the RX chain">
<bpmn:incoming>p6_f2</bpmn:incoming>
<bpmn:outgoing>p6_f3</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p6_mc" name="Receiver multicoupler: one RX feed → every repeater">
<bpmn:incoming>p6_f3</bpmn:incoming>
<bpmn:outgoing>p6_f4</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p6_rpt" name="Base repeater for that channel / timeslot receives (RSSI on panel)">
<bpmn:incoming>p6_f4</bpmn:incoming>
<bpmn:outgoing>p6_f5</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="p6_gr" name="Repeater healthy?">
<bpmn:incoming>p6_f5</bpmn:incoming>
<bpmn:outgoing>p6_f6</bpmn:outgoing>
<bpmn:outgoing>p6_f7</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="p6_hs" name="Hot-standby repeater takes over; alarm to NMS">
<bpmn:incoming>p6_f7</bpmn:incoming>
<bpmn:outgoing>p6_f8</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="p6_grm" name="">
<bpmn:incoming>p6_f6</bpmn:incoming>
<bpmn:incoming>p6_f8</bpmn:incoming>
<bpmn:outgoing>p6_f9</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="p6_ctl" name="Trunking / DMR controller: checks radio ID, assigns channel, sets priority (GPS timing)">
<bpmn:incoming>p6_f9</bpmn:incoming>
<bpmn:outgoing>p6_f10</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="p6_ge" name="Emergency flag set?">
<bpmn:incoming>p6_f10</bpmn:incoming>
<bpmn:outgoing>p6_f11</bpmn:outgoing>
<bpmn:outgoing>p6_f12</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="p6_pre" name="Pre-empt the channel; push emergency to console">
<bpmn:incoming>p6_f12</bpmn:incoming>
<bpmn:outgoing>p6_f13</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="p6_gem" name="">
<bpmn:incoming>p6_f11</bpmn:incoming>
<bpmn:incoming>p6_f13</bpmn:incoming>
<bpmn:outgoing>p6_f14</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="p6_rt" name="Route: console (always), surface patch, data servers">
<bpmn:incoming>p6_f14</bpmn:incoming>
<bpmn:outgoing>p6_f15</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="p6_gd" name="Rebroadcast underground?">
<bpmn:incoming>p6_f15</bpmn:incoming>
<bpmn:outgoing>p6_f16</bpmn:outgoing>
<bpmn:outgoing>p6_f17</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="p6_eno" name="Routed to console / surface / data only">
<bpmn:incoming>p6_f17</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="p6_rtx" name="Repeater transmits on the downlink frequency">
<bpmn:incoming>p6_f16</bpmn:incoming>
<bpmn:outgoing>p6_f18</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p6_comb" name="Transmitter combiner (cavity / hybrid) merges all repeaters">
<bpmn:incoming>p6_f18</bpmn:incoming>
<bpmn:outgoing>p6_f19</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="p6_dup2" name="Duplexer → headend amp → downlink into the leaky feeder">
<bpmn:incoming>p6_f19</bpmn:incoming>
<bpmn:outgoing>p6_f20</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="p6_e" name="Downlink on the feeder (p.3, reversed)">
<bpmn:incoming>p6_f20</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="p6_f0" name="" sourceRef="p6_s" targetRef="p6_ha"/>
<bpmn:sequenceFlow id="p6_f1" name="" sourceRef="p6_ha" targetRef="p6_att"/>
<bpmn:sequenceFlow id="p6_f2" name="" sourceRef="p6_att" targetRef="p6_dup"/>
<bpmn:sequenceFlow id="p6_f3" name="" sourceRef="p6_dup" targetRef="p6_mc"/>
<bpmn:sequenceFlow id="p6_f4" name="" sourceRef="p6_mc" targetRef="p6_rpt"/>
<bpmn:sequenceFlow id="p6_f5" name="" sourceRef="p6_rpt" targetRef="p6_gr"/>
<bpmn:sequenceFlow id="p6_f6" name="Yes" sourceRef="p6_gr" targetRef="p6_grm"/>
<bpmn:sequenceFlow id="p6_f7" name="No" sourceRef="p6_gr" targetRef="p6_hs"/>
<bpmn:sequenceFlow id="p6_f8" name="" sourceRef="p6_hs" targetRef="p6_grm"/>
<bpmn:sequenceFlow id="p6_f9" name="" sourceRef="p6_grm" targetRef="p6_ctl"/>
<bpmn:sequenceFlow id="p6_f10" name="" sourceRef="p6_ctl" targetRef="p6_ge"/>
<bpmn:sequenceFlow id="p6_f11" name="No" sourceRef="p6_ge" targetRef="p6_gem"/>
<bpmn:sequenceFlow id="p6_f12" name="Yes" sourceRef="p6_ge" targetRef="p6_pre"/>
<bpmn:sequenceFlow id="p6_f13" name="" sourceRef="p6_pre" targetRef="p6_gem"/>
<bpmn:sequenceFlow id="p6_f14" name="" sourceRef="p6_gem" targetRef="p6_rt"/>
<bpmn:sequenceFlow id="p6_f15" name="" sourceRef="p6_rt" targetRef="p6_gd"/>
<bpmn:sequenceFlow id="p6_f16" name="Yes" sourceRef="p6_gd" targetRef="p6_rtx"/>
<bpmn:sequenceFlow id="p6_f17" name="No" sourceRef="p6_gd" targetRef="p6_eno"/>
<bpmn:sequenceFlow id="p6_f18" name="" sourceRef="p6_rtx" targetRef="p6_comb"/>
<bpmn:sequenceFlow id="p6_f19" name="" sourceRef="p6_comb" targetRef="p6_dup2"/>
<bpmn:sequenceFlow id="p6_f20" name="" sourceRef="p6_dup2" targetRef="p6_e"/>
<bpmn:textAnnotation id="p6_a1"><bpmn:text>NMS polls every repeater, amp, PSU, switch and fibre node; alarms go to the comms tech (p.7)</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="p6_a2"><bpmn:text>Room services: 19″ racks, earth bar, surge arrestors, HVAC, fire suppression, UPS + standby generator</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
