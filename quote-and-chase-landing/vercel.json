{
  "cleanUrls": true,
  "functions": {
    "api/demo.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/msg.js": {
      "maxDuration": 30,
      "memory": 256
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
